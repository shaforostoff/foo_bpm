<?xml version="1.0" encoding="utf-8"?>
<!--
  Imported into every C++ project of the build via
  /p:ForceImportBeforeCppTargets, by scripts\build_release.ps1.

  The SDK's own projects expect WTL on the global include path - that was a
  VC++ Directories setting in Visual Studio 2010, which is per-machine and not
  something a checkout can carry. Injecting it here keeps external\ self
  contained and leaves the downloaded SDK sources untouched.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <FooBpmExternalDir>$(MSBuildThisFileDirectory)..\external\</FooBpmExternalDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)compat;$(FooBpmExternalDir)wtl\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)compat;$(FooBpmExternalDir)wtl\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>
